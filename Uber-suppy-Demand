      "source": [
        "# SQL Query 4: Root cause analysis\n",
        "query4 = '''\n",
        "SELECT\n",
        "    Time_Slot,\n",
        "    SUM(CASE WHEN Status = 'Cancelled'          THEN 1 ELSE 0 END)  AS Cancelled,\n",
        "    SUM(CASE WHEN Status = 'No Cars Available'   THEN 1 ELSE 0 END)  AS No_Cars_Available,\n",
        "    SUM(Is_Gap)                                                       AS Total_Gap,\n",
        "    CASE\n",
        "        WHEN SUM(CASE WHEN Status = 'Cancelled' THEN 1 ELSE 0 END) >\n",
        "             SUM(CASE WHEN Status = 'No Cars Available' THEN 1 ELSE 0 END)\n",
        "        THEN 'Driver Cancellations'\n",
        "        ELSE 'No Cars Available'\n",
        "    END                                                               AS Root_Cause\n",
        "FROM uber_requests\n",
        "WHERE Is_Gap = 1\n",
        "GROUP BY Time_Slot\n",
        "ORDER BY Total_Gap DESC\n",
        "'''\n",
        "result4 = pd.read_sql_query(query4, conn)\n",
        "print(\"SQL Query 4: Root Cause by Time Slot\")\n",
